<div class="block__chats">
    <div class="profile__link">
        {{{ LinkProfile }}}
    </div>
    {{{ SearchInput }}}
    {{{ CreateChatLink }}}
    {{#if isOpenCreateChat}} {{{ CreateChatPopup }}} {{/if}}
    <ul class="list__chats">
        {{#each chats}}
            <li class="chat__card" 
                data-id="{{id}}"
                data-title="{{title}}"
            >
                <div class="gray-circle"></div>
                <div class="chat__message">
                    <div>{{ title }}</div>
                        <div class="message__text">
                            <p>{{last_message.content}}</p>
                        </div>
                </div>

                <div class="message__datetime">
                    <div>{{last_message.time}}</div>
                    {{#if last_message.unread_count}}
                        <div class="message__unread flex__center">
                            {{last_message.unread_count}} 
                        </div> 
                    {{/if}}  
                </div>
            </li>
        {{/each}}
    </ul>
</div>






