<div class="profile__page">
    <div class="back__block flex__center">
        {{{ ButtonBack }}}
    </div>
    <div class="profile__info">
        <div id="avatar" class="profile__photo flex__center">
            <span>Поменять аватар</span>
        </div>
        {{#if isOpenChangeAvatar}} {{{ ChangeAvatar }}}{{/if}}
        {{#unless isEditProfile}}<div>Иван</div>{{/unless}}
        
        <form>
            <table class="profile__table">
                {{#if isChangePassword}}
                    <tr>
                        <td>Старый пароль</td>
                        <td class="value">
                            {{{ InputOldPassword }}}
                        </td>
                    </tr>
                    <tr>
                        <td>Новый пароль</td>
                        <td class="value">
                            {{{ InputNewPassword }}}
                        </td>
                    </tr>
                    <tr>
                        <td>Повторите новый пароль</td>
                        <td class="value">
                            {{{ InputRepeatPassword }}}
                        </td>
                    </tr>
                {{else}}
                    {{#each user}}
                        <tr>
                            <td>{{name}}</td>
                            <td class="value">
                                {{#if ../isEditProfile}}
                                    {{{ lookup .. inputKey }}}
                                {{else}}
                                    {{value}}
                                {{/if}}
                            </td>
                        </tr>
                    {{/each}}
                {{/if}}
            </table>
            {{#if isEditProfile}}
                {{{ ButtonEdit }}}
            {{else}}
                {{#if isChangePassword}}
                    {{{ ButtonChangePassword }}}
                {{else}}
                    <div class="profile__links">
                        {{{ LinkChangeInfo }}} 
                        {{{ LinkChangePassword }}} 
                        {{{ LinkLogout }}} 
                    </div>
                {{/if}}
            {{/if}}
        </form>
        {{{ Footer }}}
    </div>
</div>





